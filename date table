DateTable = 
VAR StartDate = DATE(YEAR(TODAY()) - 3, 1, 1)   // 3 years prev, start of year
VAR EndDate   = DATE(YEAR(TODAY()) + 2, 12, 31) // 2 years future, end of year
RETURN
ADDCOLUMNS (
    CALENDAR ( StartDate, EndDate ),
    "Year", YEAR([Date]),
    "Month Number", MONTH([Date]),
    "Month Name", FORMAT([Date], "MMMM"),
    "Month-Year", FORMAT([Date], "MMM-YYYY"),
    "Quarter", "Q" & FORMAT([Date], "Q")
)


update

DateTable = 
VAR StartDate = DATE(YEAR(TODAY()) - 3, 1, 1)
VAR EndDate   = DATE(YEAR(TODAY()) + 2, 12, 31)
RETURN
ADDCOLUMNS (
    CALENDAR ( StartDate, EndDate ),
    "Year", YEAR([Date]),
    "Month Number", MONTH([Date]),
    "Month Name", FORMAT([Date], "MMMM"),
    "Month-Year", FORMAT([Date], "MMM-YYYY"),
    "Quarter", "Q" & FORMAT([Date], "Q"),
    "Fiscal Year",
        VAR M = MONTH([Date])
        VAR Y = YEAR([Date])
        RETURN IF(M >= 4, Y & "/" & Y + 1, Y - 1 & "/" & Y)
)


Lets Completed (Current FY ONLY) = 
VAR CurrentFY = [Current Financial Year]
RETURN
CALCULATE(
    COUNTROWS('Lets'),
    USERELATIONSHIP('DateTable'[Date], 'Lets'[Date Accepted (Date Only)]),
    FILTER('Lets', NOT ISBLANK('Lets'[Date Accepted])),
    FILTER('DateTable', 'DateTable'[Fiscal Year] = CurrentFY)
)

fixed 

Lets Completed (Current FY) :=
VAR CurrentFY = [Current Financial Year]
RETURN
CALCULATE(
    COUNTROWS(Lets),
    USERELATIONSHIP('DateTable'[Date], Lets[Date Accepted (Date Only)]),
    NOT ISBLANK(Lets[Date Accepted]),
    'DateTable'[Fiscal Year] = CurrentFY
)

Fiscal Month Number =
VAR M = MONTH ( DateTable[Date] )
RETURN
IF ( M >= 4, M - 3, M + 9 )


Fiscal Year Month Sort =
VAR FY =
    IF (
        MONTH ( DateTable[Date] ) >= 4,
        YEAR ( DateTable[Date] ),
        YEAR ( DateTable[Date] ) - 1
    )
VAR FM =
    IF (
        MONTH ( DateTable[Date] ) >= 4,
        MONTH ( DateTable[Date] ) - 3,
        MONTH ( DateTable[Date] ) + 9
    )
RETURN
FY * 100 + FM
