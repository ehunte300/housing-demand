DateTable = 
VAR StartDate = DATE(YEAR(TODAY()) - 3, 1, 1)   // 3 years prev, start of year
VAR EndDate   = DATE(YEAR(TODAY()) + 2, 12, 31) // 2 years future, end of year
RETURN
ADDCOLUMNS (
    CALENDAR ( StartDate, EndDate ),
    "Year", YEAR([Date]),
    "Month Number", MONTH([Date]),
    "Month Name", FORMAT([Date], "MMMM"),
    "Month-Year", FORMAT([Date], "MMM-YYYY"),
    "Quarter", "Q" & FORMAT([Date], "Q")
)
