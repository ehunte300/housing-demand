Points Priority1 = 
SWITCH(
    TRUE(),
    'Demand Export'[Points Override] >= 290, "High (290+ Points)",
    'Demand Export'[Points Override] >= 90, "Medium (90 - 290 Points)",
    'Demand Export'[Points Override] < 90, "Low (Less than 90)",
    "None"
)



Points Priority1 =
SWITCH(
    TRUE(),
    ISBLANK('Demand Export'[Points Override]), "None",
    'Demand Export'[Points Override] >= 290, "High (290+ Points)",
    'Demand Export'[Points Override] >= 90, "Medium (90 - 289 Points)",
    'Demand Export'[Points Override] < 90, "Low (Less than 90)"
)



Points Priority1 =
VAR P = 'Demand Export'[Points Override]
VAR Label =
    SWITCH(
        TRUE(),
        ISBLANK(P), "None",
        P >= 290, "High (290+ Points)",
        P >= 90,  "Medium (90 - 289 Points)",
        P < 90,   "Low (Less than 90)"
    )
RETURN
TRIM(Label)
